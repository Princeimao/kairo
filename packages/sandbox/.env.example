# Sandbox image built by `npm run sandbox:build` (override only if you rebuild)
KAIRO_SANDBOX_IMAGE=kairo-sandbox:latest

# Daemon endpoint — autodetects Docker Desktop by default
#   tcp://localhost:2375 / unix:///var/run/docker.sock / npipe:////./pipe/docker_engine
KAIRO_SANDBOX_DOCKER_HOST=

# Network mode: "bridge" (default) or "none" (fully offline sandboxes)
KAIRO_SANDBOX_NETWORK=bridge
KAIRO_SANDBOX_MEMORY_MB=1536
KAIRO_SANDBOX_CPUS=2
KAIRO_SANDBOX_PIDS_LIMIT=256
KAIRO_SANDBOX_VOLUME_MB=2048

# Output/read/write caps (bytes)
KAIRO_SANDBOX_MAX_READ_BYTES=2097152
KAIRO_SANDBOX_MAX_WRITE_BYTES=2097152
KAIRO_SANDBOX_MAX_OUTPUT_BYTES=20000
KAIRO_SANDBOX_DEFAULT_TIMEOUT_MS=60000
KAIRO_SANDBOX_MAX_EXEC_TIMEOUT_MS=600000
