generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingStep {
  WELCOME
  PROFILE
  PERMISSIONS
  DONE
}

enum AgentRunMode {
  CREATE
  FIX
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  githubId       String         @unique
  username       String
  email          String?
  name           String?
  avatarUrl      String?
  onboardingStep OnboardingStep @default(WELCOME)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  githubConnection GithubConnection?
  sessions         Session[]
  sandbox          Sandbox?
  githubEvents     GithubEvent[]

  @@map("users")
}

model GithubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  accessTokenEncrypted String
  scopes               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model GithubEvent {
  id             String   @id @default(cuid())
  userId         String?
  deliveryId     String   @unique
  eventType      String
  action         String?
  installationId String?
  repoOwner      String?
  repoName       String?
  number         Int?
  title          String?
  url            String?
  payload        Json
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("github_events")
}

model Sandbox {
  id            String   @id @default(cuid())
  userId        String   @unique
  image         String
  volumeName    String   @unique
  containerName String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActiveAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sandboxes")
}

model AgentRun {
  id           String         @id @default(cuid())
  userId       String
  mode         AgentRunMode
  prompt       String
  status       AgentRunStatus @default(QUEUED)
  repoFullName String?
  branch       String?
  prUrl        String?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  steps AgentStep[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("agent_runs")
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("agent_steps")
}
