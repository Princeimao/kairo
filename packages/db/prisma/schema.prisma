generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingStep {
  WELCOME
  PROFILE
  PERMISSIONS
  DONE
}

enum AgentRunMode {
  CREATE
  FIX
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  githubId       String         @unique
  username       String
  email          String?
  name           String?
  avatarUrl      String?
  onboardingStep OnboardingStep @default(WELCOME)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  githubConnection GithubConnection?
  sessions         Session[]
  sandbox          Sandbox?
  githubEvents     GithubEvent[]
  chatSessions     ChatSession[]
  userSkills       UserSkill[]
  scheduledRuns    ScheduledRun[]

  @@map("users")
}

/// A user-authored skill, written to /workspace/.kairo/skills/<name>/SKILL.md
/// for this user's sandbox and loaded by OpenCode's `skills` config key.
model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  /// Directory name (slug) — must be unique per user and not shadow a built-in.
  name        String
  /// Front-matter description, mirrored for listings without re-parsing.
  description String   @default("")
  /// Full SKILL.md content including YAML front-matter.
  content     String
  /// Set when the skill was imported from a URL.
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_skills")
}

/// A prompt that re-fires on a schedule (interval or daily UTC time).
/// The API process ticks these and calls the same startRun as POST /runs.
model ScheduledRun {
  id             String        @id @default(cuid())
  userId         String
  title          String        @default("")
  prompt         String
  mode           AgentRunMode  @default(CREATE)
  /// Interval preset in minutes (15, 60, 360, 1440, …) XOR dailyAt.
  intervalMinutes Int?
  /// "HH:MM" UTC — XOR intervalMinutes.
  dailyAt        String?
  active         Boolean       @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  /// Thread reused across firings; created on the first successful fire.
  conversationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@index([userId])
  @@map("scheduled_runs")
}

model GithubConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  accessTokenEncrypted String
  scopes               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model GithubEvent {
  id             String   @id @default(cuid())
  userId         String?
  deliveryId     String   @unique
  eventType      String
  action         String?
  installationId String?
  repoOwner      String?
  repoName       String?
  number         Int?
  title          String?
  url            String?
  payload        Json
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("github_events")
}

model Sandbox {
  id            String   @id @default(cuid())
  userId        String   @unique
  image         String
  volumeName    String   @unique
  containerName String   @unique
  /// sha256 of the per-container LLM proxy token (plaintext lives only in
  /// the container env; the proxy verifies by hashing the presented token).
  llmTokenHash  String?   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActiveAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sandboxes")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New session")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model Conversation {
  id        String        @id @default(cuid())
  sessionId String
  userId    String
  mode      AgentRunMode
  /// Reused across runs of this thread — OpenCode session for /workspace.
  opencodeSessionId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  session  ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages Message[]
  runs     AgentRun[]

  @@index([sessionId, createdAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  /// "USER" | "AGENT" (free-form string on purpose — UI-owned vocabulary)
  role           String
  content        String
  /// Set for AGENT messages: the run that produced them.
  runId          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AgentRun {
  id           String         @id @default(cuid())
  userId       String
  mode         AgentRunMode
  prompt       String
  status       AgentRunStatus @default(QUEUED)
  conversationId String?
  repoFullName String?
  branch       String?
  prUrl        String?
  tokensIn     Int            @default(0)
  tokensOut    Int            @default(0)
  errorMessage String?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps        AgentStep[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("agent_runs")
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("agent_steps")
}
