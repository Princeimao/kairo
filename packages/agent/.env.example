# Nebius Token Factory (see docs/model-notes.md)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Models (comma-separated "model id" list for the reliability probe)
AGENT_PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AGENT_EXECUTOR_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_PROBE_MODELS=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B,nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3_5-Lightning,nvidia/Nemotron-3-Ultra-550b-a55b

# Tool integration: "native" (AI SDK tool loop) or "json" (strict JSON actions)
AGENT_TOOL_MODE=native

# Agent loop budgets
AGENT_MAX_STEPS=25
AGENT_MAX_REPLANS=1
AGENT_TIME_BUDGET_MS=600000
AGENT_TOOL_TIMEOUT_MS=60000
AGENT_MAX_TOOL_OUTPUT_BYTES=20000
AGENT_HISTORY_TOKEN_BUDGET=60000
AGENT_MAX_STUCK_REPEATS=2
AGENT_LLM_MAX_RETRIES=2

# Workspace file limits
AGENT_MAX_READ_BYTES=1048576
AGENT_MAX_WRITE_BYTES=1048576
