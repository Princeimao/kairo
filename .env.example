# Kairo — copy to each package's .env (see package-level .env.example files)

# packages/db | apps/api (.env)
DATABASE_URL="postgresql://kairo:kairo_dev_secret@localhost:5432/kairo?schema=public"

# apps/api (.env)
PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# GitHub OAuth (real app or local stub)
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 32+ chars
SESSION_SECRET=replace-with-long-session-secret
SESSION_TTL_HOURS=720
SESSION_RENEW_INTERVAL_MINUTES=15

# Run queue + SSE relay (docker run -d -p 127.0.0.1:6379:6379 redis:7-alpine)
REDIS_URL=redis://127.0.0.1:6379
# HMAC key for per-container OpenCode passwords + LLM proxy tokens (>=16 chars)
SANDBOX_SECRET=replace-with-long-sandbox-secret

# LLM proxy upstream (OpenAI-compatible; serves the OpenCode containers)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL_ALLOWLIST=nvidia/nemotron-3.5-super-vl:free
OPENCODE_MODEL=nvidia/nemotron-3.5-super-vl:free
# LLM_PROXY_PORT=4100
# LLM_PROXY_HOST=0.0.0.0
# LLM_PROXY_BASE_URL=http://host.docker.internal:4100

# apps/web (.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
