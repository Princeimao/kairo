# Kairo — copy to each package's .env (see package-level .env.example files)

# packages/db | apps/api (.env)
DATABASE_URL="postgresql://kairo:kairo_dev_secret@localhost:5432/kairo?schema=public"

# apps/api (.env)
PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# GitHub OAuth (real app or local stub)
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 32+ chars
SESSION_SECRET=replace-with-long-session-secret
SESSION_TTL_HOURS=720
SESSION_RENEW_INTERVAL_MINUTES=15

# apps/web (.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000

# packages/agent (.env) — Stage 5 (see docs/model-notes.md)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AGENT_PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AGENT_EXECUTOR_MODEL=nvidia/nemotron-3-super-120b-a12b
AGENT_TOOL_MODE=native
AGENT_MAX_STEPS=25
AGENT_TIME_BUDGET_MS=600000
