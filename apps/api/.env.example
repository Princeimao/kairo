# API Server Configuration
# Full reference: docs/auth.md

PORT=4000
NODE_ENV=development

# Web Frontend URL (allowed CORS origin with credentials + login redirect)
WEB_URL=http://localhost:3000

# Public URL of this API (OAuth callback = {API_URL}/auth/github/callback)
API_URL=http://localhost:4000

# Database Connection (configured in Stage 2)
# DATABASE_URL="postgresql://kairo:kairo_dev_secret@localhost:5432/kairo?schema=public"

# GitHub App credentials (Settings → Developer settings → GitHub Apps)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# Slug of the Kairo App — builds https://github.com/apps/<slug>/installations/new
# GITHUB_APP_SLUG="kairo"
#
# Classic OAuth Apps ONLY: space-separated scopes. Must stay empty while
# signing in with GitHub App credentials.
# GITHUB_OAUTH_SCOPES="read:user user:email repo"

# TOKEN_ENCRYPTION_KEY: base64 of exactly 32 bytes — encrypts the GitHub token at rest
# TOKEN_ENCRYPTION_KEY=""
# SESSION_SECRET: >= 32 chars — HMAC key for session token hashes
# SESSION_SECRET=""

# SESSION_TTL_HOURS=720
# SESSION_RENEW_INTERVAL_MINUTES=15

# Advanced: OAuth endpoint overrides (GitHub Enterprise / local stub testing only)
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com

# GitHub webhook receiver (x-hub-signature-256 secret from the App's
# "Webhook" section — Webhook secret field)
# GITHUB_WEBHOOK_SECRET=""

# Run queue + SSE relay (docker run -d -p 127.0.0.1:6379:6379 redis:7-alpine)
REDIS_URL=redis://127.0.0.1:6379
# HMAC key: per-container OpenCode server password + LLM proxy token hashing
SANDBOX_SECRET=replace-with-long-sandbox-secret

# LLM proxy (this process) — containers reach it via LLM_PROXY_BASE_URL
NEBIUS_API_KEY=""
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Models the proxy forwards (comma-separated). OPENCODE_MODEL below is always
# implicitly allowed. Both are re-read from this file per request — no restart.
LLM_MODEL_ALLOWLIST=nvidia/nemotron-3.5-super-vl:free
# Model used for agent runs — WITHOUT provider prefix. The worker re-reads this
# file on every run: edits apply to the next run.
OPENCODE_MODEL=nvidia/nemotron-3.5-super-vl:free
# Alias for the proxy provider block written into sandbox opencode.json files.
# Keep a non-builtin id; builtin ids (openrouter, openai, ...) collide with
# OpenCode's built-in providers and break model resolution.
OPENCODE_PROVIDER_ID=kairo
# LLM_PROXY_PORT=4100
# LLM_PROXY_HOST=0.0.0.0
# LLM_PROXY_BASE_URL=http://host.docker.internal:4100

