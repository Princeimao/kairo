# API Server Configuration
# Full reference: docs/auth.md

PORT=4000
NODE_ENV=development

# Web Frontend URL (allowed CORS origin with credentials + login redirect)
WEB_URL=http://localhost:3000

# Public URL of this API (OAuth callback = {API_URL}/auth/github/callback)
API_URL=http://localhost:4000

# Database Connection (configured in Stage 2)
# DATABASE_URL="postgresql://kairo:kairo_dev_secret@localhost:5432/kairo?schema=public"

# GitHub OAuth App (see docs/auth.md for how to create one)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# TOKEN_ENCRYPTION_KEY: base64 of exactly 32 bytes — encrypts the GitHub token at rest
# TOKEN_ENCRYPTION_KEY=""
# SESSION_SECRET: >= 32 chars — HMAC key for session token hashes
# SESSION_SECRET=""

# SESSION_TTL_HOURS=720
# SESSION_RENEW_INTERVAL_MINUTES=15

# Advanced: OAuth endpoint overrides (GitHub Enterprise / local stub testing only)
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com
