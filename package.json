{
  "name": "Kairo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "sandbox:build": "docker build -t kairo-sandbox:latest -f sandbox/Dockerfile sandbox"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "dotenv": "^18.0.9",
    "morgan": "^1.12.1"
  }
}
